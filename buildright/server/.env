# ───────────────────────────────────────────────
# BuildRight — server environment (example)
# Copy to `.env` and fill in. NEVER commit the real .env.
# ───────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Database (local Mongo or MongoDB Atlas connection string)
MONGO_URI=mongodb://karimsazed_db_user:4n759z56wYT6aOJ0@ac-iru7dv7-shard-00-00.yb5x4oy.mongodb.net:27017,ac-iru7dv7-shard-00-01.yb5x4oy.mongodb.net:27017,ac-iru7dv7-shard-00-02.yb5x4oy.mongodb.net:27017/?ssl=true&replicaSet=atlas-pwfonn-shard-0&authSource=admin&appName=Cluster0

# karimsazed_db_user
# 4n759z56wYT6aOJ0

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — the React dev origin
CLIENT_URL=http://localhost:3000

# ── Building-permits API ────────────────────────
# Socrata SODA API is KEYLESS. An app token only raises the rate limit.
# Default dataset: City of Chicago building permits.
# We proxy + cache this through Express (see services/permitService.js).
PERMITS_BASE_URL=https://data.cityofchicago.org/resource/ydr8-5enu.json
SOCRATA_APP_TOKEN=

# ── Email (nodemailer) ──────────────────────────
# Quote requests are saved to Mongo AND emailed to the firm.
# Leave SMTP_HOST blank in dev to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BuildRight <no-reply@buildright.dev>
MAIL_TO=quotes@buildright.dev

# ── Seed admin (used by `npm run seed`) ─────────
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@buildright.dev
ADMIN_PASSWORD=admin12345
