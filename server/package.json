{
  "name": "buildright-server",
  "version": "1.0.0",
  "private": true,
  "description": "BuildRight — construction corporate site. Express + Mongoose backend.",
  "main": "src/server.js",
  "engines": {
    "node": ">22"
  },
  "scripts": {
    "start": "node src/server.js",
    "server": "nodemon src/server.js",
    "client": "npm start --prefix ../client",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "seed": "node src/utils/seed.js"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.1",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.14.2",
    "helmet": "^6.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "3.7",
    "mongoose": "^6.5.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "nodemon": "^3.1.14"
  }
}
